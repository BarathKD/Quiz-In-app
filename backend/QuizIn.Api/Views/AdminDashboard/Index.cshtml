@model DashboardVm
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-head"><h1>Dashboard</h1></div>

<div class="stat-grid">
  <div class="stat"><b>@Model.Users</b><span>Users</span></div>
  <div class="stat"><b>@Model.Categories</b><span>Categories</span></div>
  <div class="stat"><b>@Model.Questions</b><span>Questions</span></div>
  <div class="stat"><b>@Model.LevelsPassed</b><span>Levels passed</span></div>
</div>

<div class="card">
  <h2 class="card-title">Questions per category</h2>
  @if (Model.Stats.Count == 0)
  {
    <p class="muted">No categories yet. Add one under <a href="/admin/content">Content</a>, or use <a href="/admin/import">Bulk import</a>.</p>
  }
  else
  {
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr><th>Category</th><th class="num">Easy</th><th class="num">Medium</th><th class="num">Hard</th><th class="num">Total</th></tr>
        </thead>
        <tbody>
          @foreach (var s in Model.Stats)
          {
            <tr>
              <td>@s.Name</td>
              <td class="num">@s.Easy</td>
              <td class="num">@s.Medium</td>
              <td class="num">@s.Hard</td>
              <td class="num"><b>@s.Total</b></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
