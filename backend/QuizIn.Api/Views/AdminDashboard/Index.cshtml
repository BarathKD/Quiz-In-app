@model DashboardVm
@{ ViewData["Title"] = "Dashboard"; }
<h1>Dashboard</h1>
<div class="grid">
  <div class="stat"><b>@Model.Users</b>Users</div>
  <div class="stat"><b>@Model.Categories</b>Categories</div>
  <div class="stat"><b>@Model.Questions</b>Questions</div>
  <div class="stat"><b>@Model.LevelsPassed</b>Levels passed</div>
</div>
<div class="card" style="margin-top:16px;">
  <h2>Questions per category</h2>
  @if (Model.Stats.Count == 0)
  {
    <p class="muted">No categories yet. Add one under <a href="/admin/content">Content</a>, or import a CSV.</p>
  }
  else
  {
    <table>
      <tr><th>Category</th><th>Easy</th><th>Medium</th><th>Hard</th><th>Total</th></tr>
      @foreach (var s in Model.Stats)
      {
        <tr><td>@s.Name</td><td>@s.Easy</td><td>@s.Medium</td><td>@s.Hard</td><td><b>@s.Total</b></td></tr>
      }
    </table>
  }
</div>
