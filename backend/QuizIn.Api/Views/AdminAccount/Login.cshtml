@model LoginVm
@{ ViewData["Title"] = "Login"; }
<div class="card" style="max-width:380px;margin:60px auto;">
  <h1>Admin login</h1>
  @if (!string.IsNullOrEmpty(Model.Error))
  {
    <div class="err">@Model.Error</div>
  }
  <form method="post" action="/admin/login">
    @Html.AntiForgeryToken()
    <label for="Email">Email</label>
    <input id="Email" name="Email" type="email" value="@Model.Email" style="width:100%" autocomplete="username" required>
    <label for="Password">Password</label>
    <input id="Password" name="Password" type="password" style="width:100%" autocomplete="current-password" required>
    <p><button type="submit">Login</button></p>
  </form>
</div>
