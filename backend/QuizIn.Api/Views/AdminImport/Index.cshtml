@model ImportVm
@{ ViewData["Title"] = "Bulk import"; }
<div class="page-head"><h1>Bulk import</h1></div>

@if (!string.IsNullOrEmpty(Model.Error))
{
  <div class="alert alert-err">@Model.Error</div>
}
@if (Model.Added != null)
{
  <div class="alert alert-ok">Imported @Model.Added question(s).</div>
  @if (Model.Skipped != null && Model.Skipped.Count > 0)
  {
    <div class="card">
      <h2 class="card-title">Skipped (@Model.Skipped.Count)</h2>
      <ul class="help-list">
        @foreach (var line in Model.Skipped)
        {
          <li>@line</li>
        }
      </ul>
    </div>
  }
}

<div class="card">
  <h2 class="card-title">Formats</h2>
  <p class="muted"><b>Excel (.xlsx)</b> or <b>CSV</b>: first sheet, columns <b>id, question, A, B, C, D, answer, explanation</b>. The answer can be A-D, 1-4 or the answer text. The first row may be a header. For CSV save as UTF-8 (needed for Tamil). <a href="/templates/quiz-import-template.xlsx" download>Download the Excel template</a>.</p>
  <p class="muted"><b>JSON</b>: an array like this:</p>
<pre class="code">[
  { "questionText": "Capital of India?",
    "options": [ {"id":"a","text":"Delhi"}, {"id":"b","text":"Mumbai"} ],
    "correctOptionId": "a",
    "explanation": "New Delhi is the capital." }
]</pre>
  <p class="muted" style="margin:0">Missing categories, subcategories and subjects are created automatically. All questions in one import get the same difficulty.</p>
</div>

<div class="card">
  <h2 class="card-title">Import questions</h2>
  <form method="post" action="/admin/import" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <input type="hidden" id="Category" name="Category" value="@Model.Category">
    <input type="hidden" id="Subcategory" name="Subcategory" value="@Model.Subcategory">
    <input type="hidden" id="Subject" name="Subject" value="@Model.Subject">

    <div class="field">
      <label for="catSel">Category</label>
      <select id="catSel"></select>
      <input id="catNew" type="text" placeholder="New category name" hidden>
    </div>
    <div class="field">
      <label for="subSel">Subcategory</label>
      <select id="subSel"></select>
      <input id="subNew" type="text" placeholder="New subcategory name" hidden>
    </div>
    <div class="field">
      <label for="sbjSel">Subject (optional)</label>
      <select id="sbjSel"></select>
      <input id="sbjNew" type="text" placeholder="New subject name" hidden>
    </div>

    <div class="form-grid">
      <div class="field">
        <label for="Format">Format (for pasted text; files are detected by extension)</label>
        <select id="Format" name="Format">
          <option value="csv" selected="@(Model.Format != "json")">CSV</option>
          <option value="json" selected="@(Model.Format == "json")">JSON</option>
        </select>
      </div>
      <div class="field">
        <label for="Difficulty">Difficulty</label>
        <select id="Difficulty" name="Difficulty">
          @foreach (var d in new[] { "easy", "medium", "hard" })
          {
            <option value="@d" selected="@(d == Model.Difficulty)">@d</option>
          }
        </select>
      </div>
    </div>

    <div class="field">
      <label for="file">File (.xlsx, .csv or .json)</label>
      <input id="file" name="file" type="file" accept=".xlsx,.csv,.json,text/csv,application/json,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
    </div>

    <div class="field">
      <label for="Text">...or paste the questions here</label>
      <textarea id="Text" name="Text">@Model.Text</textarea>
    </div>

    <button class="btn" type="submit">Import questions</button>
  </form>
</div>

<script>
(function () {
  var tree = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tree, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
  var NEW = "__new";
  var hidden = { cat: document.getElementById("Category"), sub: document.getElementById("Subcategory"), sbj: document.getElementById("Subject") };
  var sel = { cat: document.getElementById("catSel"), sub: document.getElementById("subSel"), sbj: document.getElementById("sbjSel") };
  var txt = { cat: document.getElementById("catNew"), sub: document.getElementById("subNew"), sbj: document.getElementById("sbjNew") };

  function fill(select, names, placeholder, newLabel, wanted) {
    select.innerHTML = "";
    var first = document.createElement("option");
    first.value = ""; first.textContent = placeholder;
    select.appendChild(first);
    names.forEach(function (n) {
      var o = document.createElement("option");
      o.value = n; o.textContent = n;
      select.appendChild(o);
    });
    var add = document.createElement("option");
    add.value = NEW; add.textContent = newLabel;
    select.appendChild(add);
    if (wanted && names.indexOf(wanted) >= 0) select.value = wanted;
    else if (wanted) select.value = NEW;
    else select.value = "";
  }

  function find(list, name) { for (var i = 0; i < list.length; i++) if (list[i].name === name) return list[i]; return null; }

  function current(key) {
    if (sel[key].value === NEW) return txt[key].value.trim();
    return sel[key].value;
  }

  function refresh(initial) {
    var wantCat = initial ? hidden.cat.value : sel.cat.value;
    var wantSub = initial ? hidden.sub.value : sel.sub.value;
    var wantSbj = initial ? hidden.sbj.value : sel.sbj.value;

    fill(sel.cat, tree.map(function (c) { return c.name; }), "Choose category", "+ New category", wantCat);
    if (initial && sel.cat.value === NEW) txt.cat.value = wantCat;
    var cat = find(tree, sel.cat.value);

    fill(sel.sub, cat ? cat.subs.map(function (s) { return s.name; }) : [], "Choose subcategory", "+ New subcategory", wantSub);
    if (initial && sel.sub.value === NEW) txt.sub.value = wantSub;
    var sub = cat ? find(cat.subs, sel.sub.value) : null;

    fill(sel.sbj, sub ? sub.subjects : [], "No subject", "+ New subject", wantSbj);
    if (initial && sel.sbj.value === NEW) txt.sbj.value = wantSbj;

    ["cat", "sub", "sbj"].forEach(function (k) { txt[k].hidden = sel[k].value !== NEW; });
    sync();
  }

  function sync() {
    hidden.cat.value = current("cat");
    hidden.sub.value = current("sub");
    hidden.sbj.value = current("sbj");
  }

  sel.cat.addEventListener("change", function () { sel.sub.value = ""; sel.sbj.value = ""; txt.sub.value = ""; txt.sbj.value = ""; refresh(false); });
  sel.sub.addEventListener("change", function () { sel.sbj.value = ""; txt.sbj.value = ""; refresh(false); });
  sel.sbj.addEventListener("change", function () { refresh(false); });
  ["cat", "sub", "sbj"].forEach(function (k) { txt[k].addEventListener("input", sync); });
  document.querySelector("form[action='/admin/import']").addEventListener("submit", sync);

  refresh(true);
})();
</script>
