@model ImportVm
@{ ViewData["Title"] = "Bulk import"; }
<h1>Bulk import</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
  <div class="err">@Model.Error</div>
}
@if (Model.Added != null)
{
  <div class="ok">Imported @Model.Added question(s).</div>
  @if (Model.Skipped != null && Model.Skipped.Count > 0)
  {
    <div class="card">
      <h2>Skipped (@Model.Skipped.Count)</h2>
      <ul>
        @foreach (var line in Model.Skipped)
        {
          <li>@line</li>
        }
      </ul>
    </div>
  }
}

<div class="card">
  <h2>Formats</h2>
  <p class="muted"><b>CSV</b> columns: id, question, A, B, C, D, answer, explanation. The answer can be A-D, 1-4 or the answer text. The first row may be a header. Save as <b>UTF-8</b> (needed for Tamil). From Excel use "CSV UTF-8".</p>
  <p class="muted"><b>JSON</b>: an array like the example below. Option ids are usually a, b, c, d.</p>
<pre class="muted" style="white-space:pre-wrap">[
  { "questionText": "Capital of India?",
    "options": [ {"id":"a","text":"Delhi"}, {"id":"b","text":"Mumbai"} ],
    "correctOptionId": "a",
    "explanation": "New Delhi is the capital." }
]</pre>
  <p class="muted">Missing categories, subcategories and subjects are created automatically. All questions in one import get the same difficulty.</p>
</div>

<div class="card">
  <form method="post" action="/admin/import" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <label for="Category">Category</label>
    <input id="Category" name="Category" list="cats" value="@Model.Category" style="width:100%" required>
    <datalist id="cats">
      @foreach (var c in Model.Categories)
      {
        <option value="@c"></option>
      }
    </datalist>
    <label for="Subcategory">Subcategory</label>
    <input id="Subcategory" name="Subcategory" value="@Model.Subcategory" style="width:100%" required>
    <label for="Subject">Subject (optional)</label>
    <input id="Subject" name="Subject" value="@Model.Subject" style="width:100%">

    <div class="row">
      <div>
        <label for="Format">Format</label>
        <select id="Format" name="Format">
          <option value="csv" selected="@(Model.Format != "json")">CSV</option>
          <option value="json" selected="@(Model.Format == "json")">JSON</option>
        </select>
      </div>
      <div>
        <label for="Difficulty">Difficulty</label>
        <select id="Difficulty" name="Difficulty">
          @foreach (var d in new[] { "easy", "medium", "hard" })
          {
            <option value="@d" selected="@(d == Model.Difficulty)">@d</option>
          }
        </select>
      </div>
    </div>

    <label for="file">File (.csv or .json)</label>
    <input id="file" name="file" type="file" accept=".csv,.json,text/csv,application/json">

    <label for="Text">...or paste the questions here</label>
    <textarea id="Text" name="Text" style="min-height:160px">@Model.Text</textarea>

    <p><button type="submit">Import</button></p>
  </form>
</div>
