@* Game settings page. Route: GET /admin/settings (AdminSettingsController.Index). Model: GameSettings (loaded from the database by GameSettingsStore). The mobile app reads these values. *@
@model GameSettings
@{
    ViewData["Title"] = "Game settings";
}
@* Helper function Num(): writes a number with InvariantCulture so the value in the input is always plain digits. *@
@functions {
    public static string Num(int v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<div class="page-head"><h1>Game settings</h1></div>

@* Main settings form. Posts to POST /admin/settings (AdminSettingsController.Save). Field names match the GameSettings properties, so ASP.NET binds them automatically, then GameSettingsStore saves them. *@
<form method="post" action="/admin/settings">
  @* Anti-forgery token (CSRF protection). *@
  @Html.AntiForgeryToken()

  @* Section: number of questions in one level. *@
  <div class="card">
    <h2 class="card-title">Levels</h2>
    <div class="form-grid">
      <div class="field">
        <label for="QuestionsPerLevel">Questions per level</label>
        <input id="QuestionsPerLevel" name="QuestionsPerLevel" type="number" min="5" max="200" value="@Num(Model.QuestionsPerLevel)">
        <span class="hint">5 to 200. Set this before launch. Changing it later moves where levels start and end, so players' progress can look wrong.</span>
      </div>
    </div>
  </div>

  @* Section: practice mode pass mark in percent for each difficulty. *@
  <div class="card">
    <h2 class="card-title">Practice mode: pass mark</h2>
    <p class="muted">Percent of questions a player must answer correctly to pass a level. A wrong answer never restarts the level.</p>
    <div class="form-grid">
      <div class="field">
        <label for="PassMarkEasy">Easy (%)</label>
        <input id="PassMarkEasy" name="PassMarkEasy" type="number" min="1" max="100" value="@Num(Model.PassMarkEasy)">
      </div>
      <div class="field">
        <label for="PassMarkMedium">Medium (%)</label>
        <input id="PassMarkMedium" name="PassMarkMedium" type="number" min="1" max="100" value="@Num(Model.PassMarkMedium)">
      </div>
      <div class="field">
        <label for="PassMarkHard">Hard (%)</label>
        <input id="PassMarkHard" name="PassMarkHard" type="number" min="1" max="100" value="@Num(Model.PassMarkHard)">
      </div>
    </div>
  </div>

  @* Section: challenge mode. Checkbox trick: an unchecked checkbox sends nothing, so a hidden input with value false comes after it. When checked, both values are sent and ASP.NET takes true. Same trick for Exam and Reminder switches. *@
  <div class="card">
    <h2 class="card-title">Challenge mode</h2>
    <p class="muted">Random questions from the level, in rounds. One wrong answer ends the challenge unless the player revives by watching an ad.</p>
    <div class="field">
      <label class="check"><input type="checkbox" name="ChallengeEnabled" value="true" checked="@Model.ChallengeEnabled"> Challenge mode is on</label>
      <input type="hidden" name="ChallengeEnabled" value="false">
      <span class="hint">When off, tapping a level goes straight to Practice.</span>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="ChallengeQuestionsPerRound">Questions per round</label>
        <input id="ChallengeQuestionsPerRound" name="ChallengeQuestionsPerRound" type="number" min="3" max="50" value="@Num(Model.ChallengeQuestionsPerRound)">
      </div>
      <div class="field">
        <label for="ChallengeRounds">Rounds</label>
        <input id="ChallengeRounds" name="ChallengeRounds" type="number" min="1" max="10" value="@Num(Model.ChallengeRounds)">
        <span class="hint">If the level has fewer questions, the challenge uses what is available.</span>
      </div>
      <div class="field">
        <label for="ChallengeRevives">Revives per challenge (ads)</label>
        <input id="ChallengeRevives" name="ChallengeRevives" type="number" min="0" max="5" value="@Num(Model.ChallengeRevives)">
        <span class="hint">0 turns revives off.</span>
      </div>
      <div class="field">
        <label for="ChallengeBonusMultiplier">Bonus points multiplier</label>
        <input id="ChallengeBonusMultiplier" name="ChallengeBonusMultiplier" type="number" min="1" max="10" value="@Num(Model.ChallengeBonusMultiplier)">
        <span class="hint">Leaderboard bonus: the first Challenge win for each subject and difficulty is worth one level (50 x difficulty weight) times this number. 1 = no extra.</span>
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="ChallengeSecondsEasy">Seconds per question: Easy</label>
        <input id="ChallengeSecondsEasy" name="ChallengeSecondsEasy" type="number" min="5" max="120" value="@Num(Model.ChallengeSecondsEasy)">
      </div>
      <div class="field">
        <label for="ChallengeSecondsMedium">Seconds per question: Medium</label>
        <input id="ChallengeSecondsMedium" name="ChallengeSecondsMedium" type="number" min="5" max="120" value="@Num(Model.ChallengeSecondsMedium)">
      </div>
      <div class="field">
        <label for="ChallengeSecondsHard">Seconds per question: Hard</label>
        <input id="ChallengeSecondsHard" name="ChallengeSecondsHard" type="number" min="5" max="120" value="@Num(Model.ChallengeSecondsHard)">
      </div>
    </div>
  </div>

  @* Section: minimum app version. Older apps must update. *@
  <div class="card">
    <h2 class="card-title">App updates</h2>
    <div class="form-grid">
      <div class="field">
        <label for="MinAppVersion">Minimum app version</label>
        <input id="MinAppVersion" name="MinAppVersion" value="@Model.MinAppVersion" pattern="\d{1,4}(\.\d{1,4}){0,2}" maxlength="14">
        <span class="hint">Players on an older version see an "Update the app" screen. Keep it at 1.0.0 until you really need to force an update (for example 1.2.0).</span>
      </div>
    </div>
  </div>

  @* Section: daily challenge question count and timer. *@
  <div class="card">
    <h2 class="card-title">Daily challenge</h2>
    <div class="form-grid">
      <div class="field">
        <label for="DailyQuestionCount">Questions</label>
        <input id="DailyQuestionCount" name="DailyQuestionCount" type="number" min="3" max="50" value="@Num(Model.DailyQuestionCount)">
      </div>
      <div class="field">
        <label for="DailyTimerMinutes">Timer (minutes)</label>
        <input id="DailyTimerMinutes" name="DailyTimerMinutes" type="number" min="1" max="60" value="@Num(Model.DailyTimerMinutes)">
      </div>
    </div>
  </div>

  @* Section: exam mode (mock test) settings. *@
  <div class="card">
    <h2 class="card-title">Exam mode (mock test)</h2>
    <p class="muted">A full mock test for a subject: random questions of every difficulty, one timer for the whole test, no answers shown until the end. The player sees score, pass or fail, and rank among everyone who took the same test.</p>
    <div class="field">
      <label class="check"><input type="checkbox" name="ExamEnabled" value="true" checked="@Model.ExamEnabled"> Exam mode is on</label>
      <input type="hidden" name="ExamEnabled" value="false">
      <span class="hint">When off, the Mock test card is hidden in the app.</span>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="ExamQuestionCount">Questions per test</label>
        <input id="ExamQuestionCount" name="ExamQuestionCount" type="number" min="5" max="200" value="@Num(Model.ExamQuestionCount)">
        <span class="hint">If a subject has fewer questions, the test uses what is there.</span>
      </div>
      <div class="field">
        <label for="ExamMinutes">Time for the whole test (minutes)</label>
        <input id="ExamMinutes" name="ExamMinutes" type="number" min="1" max="240" value="@Num(Model.ExamMinutes)">
      </div>
      <div class="field">
        <label for="ExamNegativePercent">Negative marking (%)</label>
        <input id="ExamNegativePercent" name="ExamNegativePercent" type="number" min="0" max="100" value="@Num(Model.ExamNegativePercent)">
        <span class="hint">Part of one mark taken off for each wrong answer. 25 = a quarter mark, 0 = no negative marking. Unanswered questions lose nothing.</span>
      </div>
      <div class="field">
        <label for="ExamPassMark">Pass mark (%)</label>
        <input id="ExamPassMark" name="ExamPassMark" type="number" min="1" max="100" value="@Num(Model.ExamPassMark)">
      </div>
    </div>
  </div>

  @* Section: daily reminder notification time and text (Tamil and English). *@
  <div class="card">
    <h2 class="card-title">Daily reminder notification</h2>
    <p class="muted">Sent by the phone once a day at this time (India time on the player's phone). Players have no switch for it in the app, so only you control it.</p>
    <div class="field">
      <label class="check"><input type="checkbox" name="ReminderEnabled" value="true" checked="@Model.ReminderEnabled"> Reminder is on</label>
      <input type="hidden" name="ReminderEnabled" value="false">
      <span class="hint">When off, no reminder is scheduled on any phone.</span>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="ReminderHour">Hour (0 to 23)</label>
        <input id="ReminderHour" name="ReminderHour" type="number" min="0" max="23" value="@Num(Model.ReminderHour)">
        <span class="hint">20 = 8 PM.</span>
      </div>
      <div class="field">
        <label for="ReminderMinute">Minute</label>
        <input id="ReminderMinute" name="ReminderMinute" type="number" min="0" max="59" value="@Num(Model.ReminderMinute)">
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label for="ReminderTitleTa">Title (Tamil)</label>
        <input id="ReminderTitleTa" name="ReminderTitleTa" maxlength="60" value="@Model.ReminderTitleTa">
      </div>
      <div class="field">
        <label for="ReminderTitleEn">Title (English)</label>
        <input id="ReminderTitleEn" name="ReminderTitleEn" maxlength="60" value="@Model.ReminderTitleEn">
      </div>
      <div class="field">
        <label for="ReminderBodyTa">Message (Tamil)</label>
        <input id="ReminderBodyTa" name="ReminderBodyTa" maxlength="160" value="@Model.ReminderBodyTa">
      </div>
      <div class="field">
        <label for="ReminderBodyEn">Message (English)</label>
        <input id="ReminderBodyEn" name="ReminderBodyEn" maxlength="160" value="@Model.ReminderBodyEn">
      </div>
    </div>
    <span class="hint">The phone picks the Tamil or English text by the app language. The new time and text reach a phone the next time the app opens.</span>
  </div>

  @* Save button for the main form above. *@
  <div class="form-actions">
    <button class="btn" type="submit">Save settings</button>
  </div>
</form>

@* Reset form. Posts to POST /admin/settings/reset (AdminSettingsController.Reset). Replaces all settings with the defaults (new GameSettings()). *@
<form method="post" action="/admin/settings/reset" onsubmit="return confirm('Reset every setting to its default?');" style="margin-top:12px">
  @Html.AntiForgeryToken()
  <button class="btn btn-secondary" type="submit">Reset to defaults</button>
</form>
