@* Content page. Route: GET /admin/content (AdminContentController.Index). Model: List<Category> (each with Subcategories and Subjects). Shows the tree Category > Subcategory > Subject. *@
@model List<Category>
@{ ViewData["Title"] = "Content"; }
<div class="page-head"><h1>Content</h1></div>

@* Add category form. Posts to POST /admin/content/category (AdminContentController.AddCategory). The controller creates the category with name, description and timer minutes. *@
<div class="card">
  <h2 class="card-title">Add category</h2>
  <form method="post" action="/admin/content/category" class="toolbar">
    @Html.AntiForgeryToken()
    <input class="grow" name="name" placeholder="Name" aria-label="Category name" required>
    <input class="grow-2" name="description" placeholder="Description" aria-label="Description">
    <input class="fixed" name="timerMinutes" type="number" min="1" max="180" placeholder="Timer (min)" aria-label="Timer in minutes">
    <button class="btn" type="submit">Add</button>
  </form>
</div>

@* Loop: one card for each category. *@
@foreach (var cat in Model)
{
  <div class="card">
    @* Category header: image (if any), name, timer, opacity and the Edit / Delete buttons. *@
    <div class="cat-head">
      @if (!string.IsNullOrEmpty(cat.ImageUrl)) { <img class="thumb thumb-sm" src="@cat.ImageUrl" alt=""> }
      <h2>@cat.Name</h2>
      <span class="badge">@cat.TimerMinutes min</span>
      <span class="badge">opacity @cat.BackgroundOpacity.ToString("0.##")</span>
      <div class="actions">
        <a class="btn btn-secondary btn-sm" href="/admin/content/category/@cat.Id/edit">Edit</a>
        @* Delete category. Posts to POST /admin/content/category/{id}/delete (AdminContentController.DeleteCategory). Also deletes its questions. The onsubmit confirm() asks the admin first. *@
        <form method="post" action="/admin/content/category/@cat.Id/delete" onsubmit="return confirm('Delete this category and ALL its questions?');">
          @Html.AntiForgeryToken()
          <button class="btn btn-danger btn-sm" type="submit">Delete</button>
        </form>
      </div>
    </div>
    @if (!string.IsNullOrEmpty(cat.Description)) { <p class="cat-desc">@cat.Description</p> }

    @* Tree of subcategories of this category (ordered by Id). *@
    <div class="tree">
      @foreach (var sub in cat.Subcategories.OrderBy(s => s.Id))
      {
        <div class="tree-sub">
          <div class="sub-head">
            <span class="name">@sub.Name</span>
            <div class="actions">
              @* Questions button opens the questions list filtered by target=subcategoryId-subjectId. The 0 means no subject. *@
              <a class="btn btn-secondary btn-sm" href="/admin/questions?target=@(sub.Id)-0">Questions</a>
              @* Delete subcategory. Posts to POST /admin/content/subcategory/{id}/delete (AdminContentController.DeleteSubcategory). Also deletes its questions. *@
              <form method="post" action="/admin/content/subcategory/@sub.Id/delete" onsubmit="return confirm('Delete this subcategory and its questions?');">
                @Html.AntiForgeryToken()
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
              </form>
            </div>
          </div>

          @* Show the subject list only when this subcategory has subjects. *@
          @if (sub.Subjects.Count > 0)
          {
            <div class="subject-list">
              @foreach (var subject in sub.Subjects.OrderBy(x => x.Id))
              {
                <div class="subject-row">
                  <span class="name">@subject.Name</span>
                  @if (subject.TimerMinutes != null) { <span class="badge">@subject.TimerMinutes min</span> }
                  <div class="actions">
                    <a class="btn btn-secondary btn-sm" href="/admin/questions?target=@(sub.Id)-@(subject.Id)">Questions</a>
                    @* Delete subject. Posts to POST /admin/content/subject/{id}/delete (AdminContentController.DeleteSubject). Also deletes its questions. *@
                    <form method="post" action="/admin/content/subject/@subject.Id/delete" onsubmit="return confirm('Delete this subject and its questions?');">
                      @Html.AntiForgeryToken()
                      <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                    </form>
                  </div>
                </div>
              }
            </div>
          }

          @* Add subject form. Posts to POST /admin/content/subcategory/{id}/subject (AdminContentController.AddSubject). The timer is optional. *@
          <form method="post" action="/admin/content/subcategory/@sub.Id/subject" class="add-row">
            @Html.AntiForgeryToken()
            <input class="grow" name="name" placeholder="New subject" aria-label="New subject name" required>
            <input class="fixed" name="timerMinutes" type="number" min="1" max="180" placeholder="Timer (min)" aria-label="Subject timer in minutes">
            <button class="btn btn-secondary btn-sm" type="submit">Add subject</button>
          </form>
        </div>
      }
    </div>

    @* Add subcategory form. Posts to POST /admin/content/category/{id}/subcategory (AdminContentController.AddSubcategory). *@
    <form method="post" action="/admin/content/category/@cat.Id/subcategory" class="toolbar add-cat-row">
      @Html.AntiForgeryToken()
      <input class="grow" name="name" placeholder="New subcategory" aria-label="New subcategory name" required>
      <button class="btn btn-secondary" type="submit">Add subcategory</button>
    </form>
  </div>
}
